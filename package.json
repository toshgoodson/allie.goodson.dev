{
  "name": "allie.goodson.dev",
  "version": "0.1.0",
  "description": "Allie Goodson's personal website",
  "repository": "https://github.com/toshgoodson/allie.goodson.dev",
  "author": "Tosh Goodson",
  "license": "AGPLv3",
  "private": true,
  "scripts": {
    "dev": "next dev -p ${PORT:-8084}",
    "build": "next build",
    "serve": "node scripts/serve.mjs out ${PORT:-8085}",
    "export": "rm -rf docs && cp -R out docs",
    "clean": "rm -rf .next out docs",
    "isNotDirty": "sh -c '[[ -z $(git status -s) ]]'",
    "release": "yarn install && yarn isNotDirty && yarn clean && yarn build && yarn export"
  },
  "dependencies": {
    "next": "15.5.6",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "yarn@3.4.1",
  "volta": {
    "node": "22.20.0"
  }
}
